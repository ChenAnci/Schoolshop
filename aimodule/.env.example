# ===== FastAPI 服务 =====
AI_PORT=8090
AI_HOST=0.0.0.0

# ===== 只读数据库（MySQL，对应本工程 ruoyi_vue 库） =====
AI_DB_HOST=127.0.0.1
AI_DB_PORT=3306
AI_DB_USER=root
AI_DB_PASSWORD=
AI_DB_NAME=ruoyi_vue

# ===== 内部鉴权令牌（后端调用 /analysis 时携带同一个值） =====
AI_INTERNAL_TOKEN=dev-internal-token

# ===== LLM 增强（可选，默认关闭；骨架阶段不要求） =====
ANALYSIS_ENABLE_LLM=false
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=